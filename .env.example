# Banco (docker compose)
DATABASE_URL=postgresql://spl:spl@localhost:5432/spl?schema=public
PORT=3333
# memory (padrão, sem Docker) ou prisma
PERSISTENCIA=memory
# Compatível com o template: se "prisma", liga o adapter Prisma
TAREFAS_REPO=memory
# Semear usuários, tarefas e notícias marcados como exemplo. Em produção deixe false.
SEED_EXEMPLO=true
# Cria um admin real se o banco estiver vazio (não use a senha de exemplo).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_SENHA=
BOOTSTRAP_ADMIN_NOME=
# Origens liberadas no CORS (hub local e a landing no Pages)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://splsolucoes.com,https://hub.splsolucoes.com
# Opcional. Se os dois existirem, publicar/despublicar uma notícia pede rebuild das Pages
# (POST /repos/splSolucoesTecnologicas/spl-hub/dispatches, evento blog-publicado).
# Não sobe o hub nem a API: só aciona o workflow que já publica a landing.
PAGES_DISPATCH_TOKEN=
PAGES_DISPATCH_REPOSITORIO=splSolucoesTecnologicas/spl-hub
# GitHub Projects: fake, app ou desligado. Vazio = fake em memória e desligado com Prisma.
# O fake não grava em persistência prisma: a API desliga a integração e avisa no log.
GITHUB_ADAPTER=fake
# Só com GITHUB_ADAPTER=app. A chave entra por um dos três: arquivo, base64 do .pem ou texto com \n literal.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Integração Thumdra /admin/v1 (client credentials). Vazio usa o fake em memória.
THUMDRA_ADMIN_URL=
THUMDRA_CLIENT_ID=
THUMDRA_CLIENT_SECRET=
THUMDRA_SCOPES=admin:read
# Hub (build do Next). A landing no Pages lê VITE_API_URL só na hora do build.
NEXT_PUBLIC_API_URL=http://localhost:3333
# Vazio = a seção de blog da landing sai vazia e o navegador não chama a API.
VITE_API_URL=
