# Ambiente do projeto no Dokploy. Compose: docker-compose.prod.yml
# Não commite este arquivo preenchido. A senha entra na URL do banco:
# evite @ : / # $ e espaço, ou troque esses caracteres pelo código URL.

POSTGRES_USER=spl
POSTGRES_PASSWORD=
POSTGRES_DB=spl

# Primeiro acesso ao hub. Sem isto a API sobe com a tabela vazia.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_SENHA=
BOOTSTRAP_ADMIN_NOME=Admin SPL

# O Traefik publica a API em https://splsolucoes.com/api
CORS_ORIGINS=https://splsolucoes.com
NEXT_PUBLIC_API_URL=https://splsolucoes.com/api
VITE_API_URL=https://splsolucoes.com/api

# Opcional enquanto o GitHub Pages ainda publica a landing.
PAGES_DISPATCH_TOKEN=
PAGES_DISPATCH_REPOSITORIO=splSolucoesTecnologicas/spl-hub

GITHUB_ADAPTER=fake
